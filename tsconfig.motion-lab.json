{
  // The motion lab's assets and the slideshow's harness. Each motion-lab page runs a model and a
  // page script as two module scripts; the model publishes its API on `globalThis` and the page
  // script reads it, which is why they share a program: `tsc` types the one from the other's
  // assignment. Same ratchet, same tracker: think-n711.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "packing/src/sqpack/motion_lab/assets/**/*.js",
    "packing/atlas/known-best/video/spikes/v1-slideshow/*.js",
    "packing/atlas/known-best/video/spikes/v1-slideshow/*.d.ts"
  ]
}
