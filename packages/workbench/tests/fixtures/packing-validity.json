{
  "contract": "packing.squares:PackingValidity/v1",
  "about": "Boundary arrangements for the one validity contract. src/core/runtime-contracts.ts (node --test, tests/packing-validity.test.ts) and tools/workbench_tools/packing_contracts.py (pytest, tests/test_packing_validity.py) must both reach the stated verdict and first failing clause for every case. Each case sits just inside or just outside one clause. Penetrations are built as centre offsets: an inside case is 5e-10 and an outside case 2e-9 against the 1e-9 contract tolerance.",
  "numbers": "Non-finite values are written as the strings NaN, Infinity and -Infinity; every other value is a JSON number.",
  "tolerances": {
    "contract": 1e-9,
    "catalogue-precision": 4e-6
  },
  "cases": [
    {
      "id": "pair-contact",
      "clause": "pair-overlap",
      "tolerance": "contract",
      "note": "two axis-aligned squares sharing a side",
      "expectedCount": 2,
      "snapshot": {
        "squareSide": 1,
        "container": { "originX": 0, "originY": 0, "side": 2 },
        "poses": [{ "x": 0.5, "y": 0.5, "angle": 0 }, { "x": 1.5, "y": 0.5, "angle": 0 }]
      },
      "valid": true,
      "geometryValid": true,
      "reason": null
