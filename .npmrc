# A package's install script is arbitrary code from the supply chain, and `npm install`
# runs every one of them by default. This repository's formatter, compiler, linter, bundler,
# type declarations and hook runner are exact lockfile dependencies; none needs an install
# script to be useful, so the default is off and the two intended operations are explicit:
#
#   npm ci --ignore-scripts     the install, everywhere, including CI
#   make hooks-install          that install, then the Git hooks through the local lefthook
#
# See `tbd guidelines supply-chain-hardening`.
ignore-scripts=true
