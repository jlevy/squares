# A package's install script is arbitrary code from the supply chain, and `npm install`
# runs every one of them by default. This repository's Node dependencies are three pinned
# tools -- lefthook, Biome and TypeScript -- none of which needs a script to be useful, so
# the default is off and the two that matter are run deliberately:
#
#   npm ci --ignore-scripts     the install, everywhere, including CI
#   npm run prepare             installs the Git hooks (`make hooks-install` does this)
#
# See `tbd guidelines supply-chain-hardening`.
ignore-scripts=true
