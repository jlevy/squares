# Pinned Node tooling and generated package build output.
node_modules/
/packages/workbench/dist/

# Local scratch area, by repo convention.
/attic/

# Python bytecode from the packing explorations.
__pycache__/
*.py[cod]
packing/.venv/

# The unattended runner's id reservations (`packing-campaign`): one empty marker
# directory per allocated exp id, created with an atomic mkdir. Local coordination
# state for runners sharing a filesystem; runners on separate branches use disjoint id
# blocks instead. Not shared, because the artifacts themselves are the durable record
# of which ids exist.
packing/campaign/series/.ids/

# Present only while `packing-validate` is running. Campaign runs refuse to overlap the
# gate so a shared engine rebuild or validation CPU load cannot contaminate measurements.
packing/.gate-running

# Kernel-held queue ownership. The empty file persists so an unlink cannot split one
# advisory lock into two inodes; its presence alone never means a queue is running.
.*.covering-queue.lock

# Sub-agent worktrees, created by the harness inside the repo.
.claude/worktrees/
.worktrees/

# Rendered by devtools/render_certificate_page.py and deployed by the pages workflow.
/packing/site/
attic/

# Video spike prototypes: sources are retained, generated pages are not (see their README)
packing/atlas/known-best/video/spikes/**/index*.html
packing/atlas/known-best/video/spikes/**/workbench.html
packing/atlas/known-best/video/spikes/**/review/
packing/atlas/known-best/video/spikes/**/frames/

# The annealing benchmark's per-trial rows. One JSON line per trial, and a round is tens
# of thousands of them -- 185 MB across the first night -- so they are not retained. The
# summaries beside them are kept. A round's recorded command, run at its engine commit,
# regenerates its rows, and `squares-workbench-summarize-annealing --check` compares them
# with the summaries; see packing/campaign/results/annealing/README.md.
/packing/campaign/results/annealing/*.jsonl

# The n17 sub-pattern certificate objects are hosted outside Git as release assets
# (OR-18) and listed in packing/hosted/n17-x048-session-168-certificates.yaml;
# `python -m devtools.hosted_data fetch --manifest` with that manifest puts them here.
# The README files and verification receipts in the same directories are tracked.
/packing/campaign/explorations/X048-session-168-pilots/certificates/*/*.json.gz

# Session184 native proof/control objects, retained as manifest-checked release assets.
/packing/campaign/retained/session-184-n11-readiness/*.json.gz
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-266-current-tail-a/tail-a-objects/*.json.gz
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-268-n11-first-round-control/checkpoints/*.json.gz
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-268-n11-first-round-control/*-objects/*.json.gz

# Complete exp273 dependency DAG reports are retained verbatim and hosted compressed.
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-273-tail-a-dependency-inventory/inventory.json
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-273-tail-a-dependency-inventory/fresh-inventory.json
/packing/campaign/retained/session-184-tail-a-dependencies/*.json.gz
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-274-current-tail-b-replication/tail-b-objects/*.json.gz
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-274-current-tail-b-replication/endpoint-prefix-objects/.accepted-prefix-steps.json.gz
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-276-n17-numeric-cap-first-round/checkpoints/*.json.gz
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-276-n17-numeric-cap-first-round/production-objects/*.json.gz
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-276-n17-numeric-cap-first-round/replay-objects/*.json.gz
/packing/campaign/retained/session-184-n17-numeric-cap-readiness/*.json.gz

# H293 conditional proof child: native object, preserved outside Git; custody below.
/packing/campaign/series/series-000-smoke-and-calibration/results/exp-283-parent-guard-owned-hull/conditional-node.json.gz

/packing/campaign/series/series-000-smoke-and-calibration/results/exp-284-parent-guard-native-custody/conditional-node.json.gz
