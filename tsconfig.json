{
  // The workbench's application module: the entry of the page's bundle, inlined into the
  // published page by the generator, and typed here with the package modules it imports.
  //
  // **The ratchet (floor rule 8).** At the full floor this program reports 1,145 errors and
  // with the four flags below relaxed it reports 109, so the four are off and the 109 are
  // the work. The default stays strict in tsconfig.base.json; nothing else in the repository
  // inherits this relaxation, and files move OUT of it, never in. Tracked as think-n711.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["packages/workbench/src/application.js"]
}
