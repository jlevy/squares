def SquarePackingArchive.IsMinimumSide : ℕ → ℝ → Prop :=
fun squareCount side =>
  SquarePackingArchive.HasPacking squareCount side ∧ SquarePackingArchive.IsLowerBound squareCount side
def SquarePackingArchive.IsLowerBound : ℕ → ℝ → Prop :=
fun squareCount side =>
  ∀ (candidateSide : ℝ), SquarePackingArchive.HasPacking squareCount candidateSide → side ≤ candidateSide
def SquarePackingArchive.HasPacking : ℕ → ℝ → Prop :=
fun squareCount side => Nonempty (SquarePackingArchive.Packing squareCount side)
structure SquarePackingArchive.Packing (squareCount : ℕ) (side : ℝ) : Type
number of parameters: 2
fields:
  SquarePackingArchive.Packing.squares : Fin squareCount → SquarePackingArchive.PlacedSquare
  SquarePackingArchive.Packing.side_nonnegative : 0 ≤ side
  SquarePackingArchive.Packing.fits : ∀ (index : Fin squareCount), (self.squares index).Fits side
  SquarePackingArchive.Packing.disjoint : ∀ (left right : Fin squareCount),
      left ≠ right → (self.squares left).InteriorDisjoint (self.squares right)
constructor:
  SquarePackingArchive.Packing.mk {squareCount : ℕ} {side : ℝ}
    (squares : Fin squareCount → SquarePackingArchive.PlacedSquare) (side_nonnegative : 0 ≤ side)
    (fits : ∀ (index : Fin squareCount), (squares index).Fits side)
    (disjoint : ∀ (left right : Fin squareCount), left ≠ right → (squares left).InteriorDisjoint (squares right)) :
    SquarePackingArchive.Packing squareCount side
structure SquarePackingArchive.PlacedSquare : Type
number of parameters: 0
fields:
  SquarePackingArchive.PlacedSquare.center : SquarePackingArchive.Point
  SquarePackingArchive.PlacedSquare.frame : SquarePackingArchive.Frame
constructor:
  SquarePackingArchive.PlacedSquare.mk (center : SquarePackingArchive.Point) (frame : SquarePackingArchive.Frame) :
    SquarePackingArchive.PlacedSquare
structure SquarePackingArchive.Frame : Type
number of parameters: 0
fields:
  SquarePackingArchive.Frame.cosine : ℝ
  SquarePackingArchive.Frame.sine : ℝ
  SquarePackingArchive.Frame.unit : self.cosine ^ 2 + self.sine ^ 2 = 1
constructor:
  SquarePackingArchive.Frame.mk (cosine sine : ℝ) (unit : cosine ^ 2 + sine ^ 2 = 1) : SquarePackingArchive.Frame
def SquarePackingArchive.PlacedSquare.point : SquarePackingArchive.PlacedSquare → ℝ → ℝ → SquarePackingArchive.Point :=
fun square localX localY =>
  have offset := square.frame.place localX localY;
  { x := square.center.x + offset.x, y := square.center.y + offset.y }
def SquarePackingArchive.PlacedSquare.Contains : SquarePackingArchive.PlacedSquare →
  SquarePackingArchive.Point → Prop :=
fun square point => ∃ localX localY, |localX| ≤ 1 / 2 ∧ |localY| ≤ 1 / 2 ∧ point = square.point localX localY
def SquarePackingArchive.PlacedSquare.InteriorContains : SquarePackingArchive.PlacedSquare →
  SquarePackingArchive.Point → Prop :=
fun square point => ∃ localX localY, |localX| < 1 / 2 ∧ |localY| < 1 / 2 ∧ point = square.point localX localY
def SquarePackingArchive.Container.Contains : ℝ → SquarePackingArchive.Point → Prop :=
fun side point => 0 ≤ point.x ∧ point.x ≤ side ∧ 0 ≤ point.y ∧ point.y ≤ side
def SquarePackingArchive.PlacedSquare.Fits : SquarePackingArchive.PlacedSquare → ℝ → Prop :=
fun square side =>
  ∀ ⦃point : SquarePackingArchive.Point⦄, square.Contains point → SquarePackingArchive.Container.Contains side point
def SquarePackingArchive.PlacedSquare.InteriorDisjoint : SquarePackingArchive.PlacedSquare →
  SquarePackingArchive.PlacedSquare → Prop :=
fun left right => ∀ (point : SquarePackingArchive.Point), ¬(left.InteriorContains point ∧ right.InteriorContains point)
