def permuteMask (p : List Nat) (m : Nat) : Nat :=
  ((List.range 16).filter fun i => m.testBit i).foldl (fun acc i => acc + 2^(p[i]!)) 0
def orbit (f : Finset Nat) : List (Finset Nat) := markerPerms.map fun p => f.image (permuteMask p)
