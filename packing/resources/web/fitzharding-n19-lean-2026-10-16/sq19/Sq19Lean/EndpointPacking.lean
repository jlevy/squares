noncomputable def squares : Fin 19 → Set (ℝ × ℝ) := ![S0, S1, S2, S3, S4, S5, S6, S7, S8, S9, S10, S11, S12, S13, S14, S15, S16, S17, S18]

theorem squares_unit (i : Fin 19) : IsUnitSquare (squares i) := by
