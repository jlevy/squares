/-- Nineteen unit squares with pairwise disjoint interiors fit in the square of side `side19`. -/
theorem endpoint_packing : ∃ S : Fin 19 → Set (ℝ × ℝ),
    (∀ i, IsUnitSquare (S i)) ∧
    (∀ i, ∀ z ∈ S i, 0 ≤ z.1 ∧ z.1 ≤ side19 ∧ 0 ≤ z.2 ∧ z.2 ≤ side19) ∧
    (∀ i j, i ≠ j → Disjoint (interior (S i)) (interior (S j))) :=
  ⟨squares, squares_unit, squares_contained, squares_disjoint⟩

end Sq19

