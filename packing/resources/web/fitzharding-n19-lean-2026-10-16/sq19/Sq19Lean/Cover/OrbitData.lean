/-- Hex digit value (lower case). -/
def hexVal (c : Char) : ℕ :=
  if c.isDigit then c.toNat - '0'.toNat else c.toNat - 'a'.toNat + 10

/-- Parse whitespace-separated lower-case hex numbers. -/
def parseHexList (s : String) : List ℕ :=
  ((s.split (fun c => c = ' ' || c = '\n')).toList.filter (fun w => !w.isEmpty)).map
    (fun w => w.foldl (fun acc c => 16 * acc + hexVal c) 0)

