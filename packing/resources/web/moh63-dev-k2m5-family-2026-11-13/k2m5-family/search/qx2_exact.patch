+def project_fast(path, tol=1e-7, den=10 ** 12, out=None, nproc=8):
+    """Same result as project(), for large tight sets: dedupe the tight rows, choose an independent subset and the
+    free columns by float QR with pivoting, round the free variables to 1/den, solve the pivot variables exactly
+    (FLINT fmpq_mat), then check every tight row exactly (reports rows that end up below / above 1)."""
+    import qx2_tools as T, pickle, flint, numpy as np, scipy.linalg as sl
+    m, x, args, d = T.load(path)
+    EM = ExactModel(m)
+    sup = [j for j in range(m.nvar) if x[j] > 1e-13]
+    col = {j: k for k, j in enumerate(sup)}; n = len(sup)
+    cache = path.replace('.npz', '_eqs.pkl')
+    if os.path.exists(cache):
+        eqs = pickle.load(open(cache, 'rb'))
+    else:
+        eqs = []
+        for cx, cy, sx, sy in axis_corners(EM, m.R):
+            co, ar = EM.coeffs(cx, cy, 0, sx, sy)
+            v = float(ar) + sum(float(c) * x[j] for j, c in co.items())
+            if v < 1 + tol: eqs.append((co, ar))
+        ck = os.environ.get('GERMCKPT')
+        files = sorted(glob.glob(os.path.join(ck, 'c*.pkl'))) if ck else []
+        src = (r for f in files for r in pickle.load(open(f, 'rb'))) if len(files) == 64 else germ_rows_exact(EM, m.R, nproc=nproc)
+        for pose, co, ar in src:
+            v = float(ar) + sum(float(c) * x[j] for j, c in co.items())
+            if v < 1 + tol: eqs.append((co, ar))
+        pickle.dump(eqs, open(cache, 'wb'))
+    print(f"tight rows: {len(eqs)}", flush=True)
+    # every tight row must not touch a variable outside the support with nonzero coefficient (those are 0 anyway)
+    U = {}
+    for co, ar in eqs:
+        key = (tuple(sorted((col[j], F(c)) for j, c in co.items() if j in col and c != 0)), F(1) - F(ar))
+        U[key] = 1
+    rows = list(U); print(f"distinct: {len(rows)}", flush=True)
+    sig = ({col[j]: F(EM.csig[j]) for j in sup if EM.csig[j] != 0}, F(EM.w) - F(EM.const_sig))
+    A = np.zeros((len(rows) + 1, n)); b = np.zeros(len(rows) + 1)
+    for i, (co, rhs) in enumerate(rows):
+        for k, c in co: A[i, k] = float(c)
+        b[i] = float(rhs)
+    for k, c in sig[0].items(): A[-1, k] = float(c)
+    b[-1] = float(sig[1])
+    # independent rows: QR of A^T with column pivoting (sigma row first by scaling it up)
+    A[-1] *= 1e3; b[-1] *= 1e3
+    Q, Rm, prow = sl.qr(A.T, mode='economic', pivoting=True)
+    dg = np.abs(np.diag(Rm)); r = int((dg > dg[0] * 1e-10).sum())
+    sel = prow[:r]
+    print(f"float rank {r} (diag ratio at cut {dg[r-1]/dg[0]:.2e}" + (f", next {dg[r]/dg[0]:.2e})" if r < len(dg) else ")"), flush=True)
+    # pivot columns: QR of the selected rows with column pivoting
+    xw = np.array([float(x[j]) for j in sup])
+    _, R2, pcol = sl.qr(A[sel] * xw[None, :], mode='economic', pivoting=True)   # prefer large-valued pivots
+    pivc = sorted(pcol[:r]); free = [k for k in range(n) if k not in set(pivc)]
+    xs = [None] * n
+    for k in free: xs[k] = F(int(round(float(x[sup[k]]) * den)), den)
+    def exrow(i):
+        if i == len(rows): return sig[0], sig[1]
+        co, rhs = rows[i]; return dict(co), rhs
+    Mx = flint.fmpq_mat(r, r); bx = flint.fmpq_mat(r, 1)
+    pidx = {k: t for t, k in enumerate(pivc)}
+    for t, i in enumerate(sel):
+        co, rhs = exrow(i); rr = rhs
+        for k, c in co.items():
+            if k in pidx: Mx[t, pidx[k]] = flint.fmpq(c.numerator, c.denominator)
+            else: rr -= c * xs[k]
+        bx[t, 0] = flint.fmpq(rr.numerator, rr.denominator)
+    sol = Mx.solve(bx)
+    for k, t in pidx.items():
+        v = sol[t, 0]; xs[k] = F(int(v.p), int(v.q))
+    # exact check of every tight row and sigma
+    below = above = 0; worst = F(0)
+    for co, rhs in rows:
+        lhs = sum(c * xs[k] for k, c in co)
+        if lhs < rhs:
+            below += 1; worst = min(worst, lhs - rhs)
+        elif lhs > rhs: above += 1
+    sres = sum(c * xs[k] for k, c in sig[0].items()) - sig[1]
+    print(f"exact check: rows below 1: {below} (worst {float(worst):.3e}), above 1: {above}, sigma residual {sres}", flush=True)
+    xe = [F(0)] * m.nvar
+    for k, j in enumerate(sup): xe[j] = xs[k]
+    neg = [j for j in sup if xe[j] < 0]
+    dev = max(abs(float(xe[j]) - x[j]) for j in range(m.nvar))
+    D = m.R ** 2 - sum(EM.cobj[j] * xe[j] for j in range(m.nvar)) - EM.const_obj
+    sg = EM.w - EM.const_sig - sum(EM.csig[j] * xe[j] for j in range(m.nvar))
+    print(f"exact: D = {float(D):.12f} (float LP {float(d['D']):.12f}); sigma = {sg}; negative: {len(neg)}; "
+          f"max |x_exact - x_float| = {dev:.3e}; denominators up to {max(v.denominator for v in xe)}", flush=True)
+    res = dict(sol=path, args=vars(args), x=[str(v) for v in xe], D=str(D), Dfloat=float(D), sigma=str(sg),
+               n_eq=len(rows), rank=r, inconsistent=below, negative=neg, dev=dev)
+    out = out or path.replace('.npz', '_exact.json')
+    json.dump(res, open(out, 'w')); print("wrote", out)
+    return res
+
