import K2m5.InstC1
import K2m5.InstC2
import K2m5.InstC3
import K2m5.InstC4
import K2m5.InstC5
import K2m5.InstC6
import K2m5.InstC7

/-!
# `s(k² − 5) = k` for every `k ≥ 10`, from one finite hypothesis (`Valid11`)

The `k² − 5` family (`R = w = 4`, pitch `1/10`, Lebesgue from `a = 19/5`) as an instance of the
`1/10`-grid version of Daniel's generic reduction (`K2m5/Fam10.lean`, after `Sqpack/BentzFam.lean`):

* `Valid11` — **the hypothesis**, stated on the box file `sol_exact_box11.txt (k05-5)` verbatim (`box11Cover`, from
  `InstData.boxSegs`/`boxPolyVerts`/`boxPolyW`, generated by `scripts/gen_fam10_data.py`): every
  closed unit square in `[0,11]²` has mass `≥ 1`.  The computer checkers assert it.
* `fam5` — the family (`sol_exact_family.txt` as two code tables); `famCover fam5 k` is `μ_k`.
* `box11Cover_measure` — `famCover fam5 11` *is* the box file (kernel evaluation).
* `famCover_total5` — the total mass of `μ_k` is `k² − 4D` for every `k ≥ 9`.
* **`k2m5_of_valid11`** — `Valid11 → ∀ k ≥ 10, minSide (k² − 5) = k`.
-/

open MeasureTheory Finset
open scoped ENNReal

namespace SquarePacking
namespace K2m5Inst

open Fam10

/-! ## 1.  The hypothesis -/

/-- **The box cover `sol_exact_box11.txt (k05-5)`** (container `[0,11]²`, coordinates `X/10`, masses `w/(2·10¹²)`),
verbatim. -/
noncomputable def box11Cover : MixedCover Empty (Fin boxSegs.length) Unit :=
  fileCover 2000000000000 boxSegs boxPolyVerts boxPolyW

/-- **`Valid11`**: every closed unit square inside `[0,11]²` has mass `≥ 1` under the box cover. -/
def Valid11 : Prop :=
  ∀ (c : ℝ × ℝ) (θ : ℝ), sq c θ 1 ⊆ box 11 → 1 ≤ box11Cover.measure (sq c θ 1)

/-! ## 2.  The family -/

-- `fam5`, `fam5_out`: `K2m5/InstFam.lean`.

/-! ## 3.  `famCover fam5 11` is the box file (kernel evaluation) -/

-- `boxSegs_ok`, `boxKeys_eq`, `boxGridKeys_strict`, and the two halves each of
-- `gridKeys_eq` and of the sort: `K2m5/InstC1..C7.lean`
-- (one kernel check per module, so each fits in memory).

theorem gridKeys_eq : gridKeys fam5 11 = boxGridKeys := by
  rw [gridKeys_split, gkPart_false, gkPart_true, List.take_append_drop]

/-- The file's keys are a permutation of the grid keys (the sort is checked in two halves, by orientation:
keys below `2 · 4096²` are horizontal pieces). -/
theorem boxKeys_perm : boxKeys.Perm (gridKeys fam5 11) := by
  have h := (List.filter_append_perm (fun k => Nat.blt k 33554432) boxKeys).symm
  refine h.trans ?_
  rw [gridKeys_eq, ← List.take_append_drop 6622 boxGridKeys, ← boxKeys_sortA, ← boxKeys_sortB]
  exact (msort_perm _ _).symm.append (msort_perm _ _).symm

lemma boxPolyVerts_eq :
    boxPolyVerts = [(38, 38), (10 * 11 - 38, 38), (10 * 11 - 38, 10 * 11 - 38), (38, 10 * 11 - 38)] :=
  rfl

/-- **The box file's measure is `μ₁₁` of the family.** -/
theorem box11Cover_measure : box11Cover.measure = (famCover fam5 11).measure :=
  fileCover_measure fam5 fam5_out 11 boxSegs boxPolyVerts boxPolyW boxSegs_ok (by norm_num) boxKeys
    boxKeys_eq boxKeys_perm (gridKeys_eq ▸ boxGridKeys_strict)
    (by rw [boxPolyVerts_eq]; exact convPoly_sq 38 11 (by norm_num))
    (by simp only [boxPolyW, fam5]; norm_num)

/-! ## 4.  Accounting -/

theorem hpoly_false (m : ℕ) : Hpoly fam5 false m = 73666628465572 + m * 15200000000000 := by
  have h00 : H00 4 (tabW famTab) = 73666628465572 := by decide +kernel
  have h01 : H01 4 (tabW famTab) = 9124746519048 := by decide +kernel
  have h10 : H10 4 (tabW famTab) = 6075253480952 := by decide +kernel
  have h11 : H11 4 (tabW famTab) = 0 := by decide +kernel
  simp only [Hpoly, fam5, Fam.layer, Bool.false_eq_true, if_false, h00, h01, h10, h11]
  ring

theorem hpoly_true (m : ℕ) : Hpoly fam5 true m = 11103823392 := by
  have h00 : H00 4 (tabW famTab2) = 11103823392 := by decide +kernel
  have h01 : H01 4 (tabW famTab2) = 0 := by decide +kernel
  have h10 : H10 4 (tabW famTab2) = 0 := by decide +kernel
  have h11 : H11 4 (tabW famTab2) = 0 := by decide +kernel
  simp only [Hpoly, fam5, Fam.layer, if_true, h00, h01, h10, h11]
  ring

/-- **Accounting**: the total mass of `μ_k` is `k² − 4D`, `D = 2681133855518/(2·10¹²)`, for every
`k ≥ 9`. -/
theorem famCover_total5 (m : ℕ) :
    (famCover fam5 (m + 9)).total
      = (((m + 9 : ℕ) : ℝ)) ^ 2 - 4 * (2681133855518 / 2000000000000) := by
  have h := famCover_total fam5 m
  rw [show m + 2 * fam5.R + 1 = m + 9 from rfl, hpoly_false, hpoly_true] at h
  rw [h]
  simp only [fam5]
  push_cast
  ring

/-! ## 5.  The end theorem -/

/-- **`s(k² − 5) = k` for all `k ≥ 10`, from `Valid11`.** -/
theorem k2m5_of_valid11 (h : Valid11) : ∀ k : ℕ, 10 ≤ k → minSide (k ^ 2 - 5) = k := by
  intro k hk
  have hval : ∀ (c : ℝ × ℝ) (θ : ℝ), sq c θ 1 ⊆ box ((2 * fam5.R + 3 : ℕ) : ℝ) →
      1 ≤ (famCover fam5 (2 * fam5.R + 3)).measure (sq c θ 1) := fun c θ hS => by
    rw [show 2 * fam5.R + 3 = 11 from rfl] at hS ⊢
    have h11 := h c θ (by rwa [Nat.cast_ofNat] at hS)
    rwa [box11Cover_measure] at h11
  obtain ⟨m, rfl⟩ : ∃ m, k = m + 9 := ⟨k - 9, by omega⟩
  have h5 : 5 < (m + 9) ^ 2 := by nlinarith
  refine minSide_eq fam5 fam5_out (by decide) hval (by simp only [fam5]; omega) (by omega) ?_
    (by rw [pow_two]; exact Nat.sub_le _ _)
  rw [famCover_total5, Nat.cast_sub h5.le]
  push_cast
  norm_num

end K2m5Inst
end SquarePacking
