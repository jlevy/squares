{"created": "2026-10-24T22:06:19.440017+00:00", "modified": "2026-10-24T22:06:19.733862+00:00", "id": 23627827, "conceptrecid": "23627826", "doi": "10.5281/zenodo.23627827", "conceptdoi": "10.5281/zenodo.23627826", "doi_url": "https://doi.org/10.5281/zenodo.23627827", "metadata": {"title": "Packing unit squares in a square of side just below an integer: a two-strip construction with O(\u221aK) deficit", "doi": "10.5281/zenodo.23627827", "publication_date": "2026-10-24", "description": "<p>Let s(n) be the side of the smallest square containing n non-overlapping unit squares. We show that for every integer K &ge; 16, s(n) &lt; K whenever n &le; K&sup2; &minus; 8&radic;K &minus; 19; equivalently, the wasted area is W(s) &le; 8&radic;K + 19 for s in [K &minus; 1/K, K). The best known general bound W(s) = O(s^{3/5}) gives only a deficit of order K^{3/5} in this regime. The proof is an explicit construction: two strips of squares tilted by an angle of order K^{&minus;1/2}, one on the bottom wall and one on the right wall, with an axis-parallel grid elsewhere. Exact rational certificates of 683 improved upper bounds obtained with optimised versions of this construction are deposited at https://doi.org/10.5281/zenodo.23624433.</p>", "access_right": "open", "creators": [{"name": "Karimi, Mohsen", "affiliation": "Independent researcher, Zanjan, Iran", "orcid": "0009-0004-1055-8267"}], "keywords": ["square packing", "wasted area", "upper bounds", "discrete geometry"], "version": "V1.0", "language": "eng", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "alternate_identifiers": [{"identifier": "10.5281/zenodo.23624433"}], "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": false, "parent": {"pid_type": "recid", "pid_value": "23627826"}}]}}, "title": "Packing unit squares in a square of side just below an integer: a two-strip construction with O(\u221aK) deficit", "links": {"self": "https://zenodo.org/api/records/23627827", "self_html": "https://zenodo.org/records/23627827", "preview_html": "https://zenodo.org/records/23627827?preview=1", "doi": "https://doi.org/10.5281/zenodo.23627827", "self_doi": "https://doi.org/10.5281/zenodo.23627827", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23627827", "reserve_doi": "https://zenodo.org/api/records/23627827/draft/pids/doi", "parent": "https://zenodo.org/api/records/23627826", "parent_html": "https://zenodo.org/records/23627826", "parent_doi": "https://doi.org/10.5281/zenodo.23627826", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23627826", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23627827/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23627827/sequence/default", "files": "https://zenodo.org/api/records/23627827/files", "media_files": "https://zenodo.org/api/records/23627827/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:23627827:karimi_near_integer.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:23627827:karimi_near_integer.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:23627827:karimi_near_integer.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:23627827:karimi_near_integer.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:23627827:karimi_near_integer.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:23627827:karimi_near_integer.pdf/full/%5E1200,/0/default.jpg"}, "latest": "https://zenodo.org/api/records/23627827/versions/latest", "latest_html": "https://zenodo.org/records/23627827/latest", "versions": "https://zenodo.org/api/records/23627827/versions", "draft": "https://zenodo.org/api/records/23627827/draft", "access_links": "https://zenodo.org/api/records/23627827/access/links", "access_grants": "https://zenodo.org/api/records/23627827/access/grants", "access_users": "https://zenodo.org/api/records/23627827/a