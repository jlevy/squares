namespace UnitSquarePacking.Data.N651

open UnitSquarePacking.Cert

theorem heads : headsOK D (82 * 8) L = true :=
  headsOK_chunks D L 82 8 (fun i hi => by
    interval_cases i
    · exact chunk_0
    · exact chunk_1
    · exact chunk_2
    · exact chunk_3
    · exact chunk_4
    · exact chunk_5
    · exact chunk_6
    · exact chunk_7
  )

theorem packsR : PacksR 651 ((26 : ℝ) - 1 / 10000) ((26 : ℝ) - 1 / 10000) := by
  have h := check_sound D Wn Hn Sd L (82 * 8) (by decide +kernel) (by decide +kernel) unit_ok box_ok
    sorted_ok (len_eq.trans_le (by decide)) heads
  rw [len_eq] at h
  have eW : ((Wn : ℤ) : ℝ) / ((Sd : ℤ) : ℝ) = (26 : ℝ) - 1 / 10000 := by simp only [Wn, Sd]; norm_num
  have eH : ((Hn : ℤ) : ℝ) / ((Sd : ℤ) : ℝ) = (26 : ℝ) - 1 / 10000 := by simp only [Hn, Sd]; norm_num
  rwa [eW, eH] at h

end UnitSquarePacking.Data.N651
